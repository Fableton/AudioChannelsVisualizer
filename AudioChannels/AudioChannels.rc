#include <winresrc.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Fableton"
            VALUE "FileDescription", "AudioChannels - Monitor de canales de audio"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "AudioChannels"
            VALUE "LegalCopyright", "Copyright (C) 2026 Fableton"
            VALUE "OriginalFilename", "AudioChannels.exe"
            VALUE "ProductName", "AudioChannels"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
